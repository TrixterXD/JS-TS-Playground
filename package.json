{
    "name": "js-ts-playground",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "check": "biome check .",
        "format": "biome format --write .",
        "typecheck": "tsc -b",
        "exercise": "tsx",
        "new-exercise": "tsx scripts/create-exercise.ts",
        "test:scaffold": "tsx --test scripts/create-exercise.test.ts",
        "preview": "vite preview"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "tsx": "^4.23.15",
        "typescript": "~7.0.2",
        "vite": "^8.3.5"
    }
}
